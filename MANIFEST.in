include *.md
include *.txt
include *.ini
include setup.*
include ChangeLog
include Makefile
include MANIFEST.in


graft nltk
graft web

# tools/ holds dev-only CI guards and maintenance scripts (no __init__.py, so it
# is never a wheel package). Do NOT graft it: shipping executable scripts in the
# sdist would put maintenance tooling on end-user machines for no runtime need.
prune tools

# graft nltk sweeps in whatever sits under the tree, tracked or not: the
# 3.10.3 sdist shipped 293 stale bytecode files. Never ship compiled caches.
global-exclude *.py[cod]
global-exclude *~
