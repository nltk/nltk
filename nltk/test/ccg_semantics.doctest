==============================================
Combinatory Categorial Grammar with semantics
==============================================

-----
Chart
-----


    >>> from nltk.ccg import chart, lexicon
    >>> from nltk.ccg.chart import printCCGDerivation

No semantics
-------------------

    >>> lex = lexicon.fromstring('''
    ...     :- S, NP, N
    ...     She => NP
    ...     has => (S\\NP)/NP
    ...     books => NP
    ...     ''',
    ...     False)

    >>> parser = chart.CCGChartParser(lex, chart.DefaultRuleSet)
    >>> parses = list(parser.parse("She has books".split()))
    >>> print(str(len(parses)) + " parses")
    3 parses

    >>> printCCGDerivation(parses[0])
     She      has      books
     NP   ((S\NP)/NP)   NP
         -------------------->
                (S\NP)
    -------------------------<
                S

    >>> printCCGDerivation(parses[1])
     She      has      books
     NP   ((S\NP)/NP)   NP
    ----->T
    (S/(S\NP))
         -------------------->
                (S\NP)
    ------------------------->
                S


    >>> printCCGDerivation(parses[2])
     She      has      books
     NP   ((S\NP)/NP)   NP
    ----->T
    (S/(S\NP))
    ------------------>B
          (S/NP)
    ------------------------->
                S

Simple semantics
-------------------

    >>> lex = lexicon.fromstring('''
    ...     :- S, NP, N
    ...     She => NP {she}
    ...     has => (S\\NP)/NP {\\x y.have(y, x)}
    ...     a => NP/N {\\P.exists z.P(z)}
    ...     book => N {book}
    ...     ''',
    ...     True)

    >>> parser = chart.CCGChartParser(lex, chart.DefaultRuleSet)
    >>> parses = list(parser.parse("She has a book".split()))
    >>> print(str(len(parses)) + " parses")
    7 parses

    >>> printCCGDerivation(parses[0])
       She                 has                           a                book
     NP {she}  ((S\NP)/NP) {\x y.have(y,x)}  (NP/N) {\P.exists z.P(z)}  N {book}
                                            ------------------------------------->
                                                   NP {exists z1.book(z1)}
              ------------------------------------------------------------------->
                           (S\NP) {\z3.have(z3,exists z5.book(z5))}
    -----------------------------------------------------------------------------<
                         S {have(she,exists z13.book(z13))}

    >>> printCCGDerivation(parses[1])
       She                 has                           a                book
     NP {she}  ((S\NP)/NP) {\x y.have(y,x)}  (NP/N) {\P.exists z.P(z)}  N {book}
              --------------------------------------------------------->B
                    ((S\NP)/N) {\F9 z6.have(z6,exists z8.F9(z8))}
              ------------------------------------------------------------------->
                         (S\NP) {\z11.have(z11,exists z10.book(z10))}
    -----------------------------------------------------------------------------<
                         S {have(she,exists z15.book(z15))}

    >>> printCCGDerivation(parses[2])
       She                 has                           a                book
     NP {she}  ((S\NP)/NP) {\x y.have(y,x)}  (NP/N) {\P.exists z.P(z)}  N {book}
    ---------->T
    (S/(S\NP)) {\F.F(she)}
                                            ------------------------------------->
                                                  NP {exists z17.book(z17)}
              ------------------------------------------------------------------->
                         (S\NP) {\z19.have(z19,exists z21.book(z21))}
    ----------------------------------------------------------------------------->
                         S {have(she,exists z30.book(z30))}

    >>> printCCGDerivation(parses[3])
       She                 has                           a                book
     NP {she}  ((S\NP)/NP) {\x y.have(y,x)}  (NP/N) {\P.exists z.P(z)}  N {book}
    ---------->T
    (S/(S\NP)) {\F.F(she)}
              --------------------------------------------------------->B
                 ((S\NP)/N) {\F25 z22.have(z22,exists z24.F25(z24))}
              ------------------------------------------------------------------->
                         (S\NP) {\z27.have(z27,exists z26.book(z26))}
    ----------------------------------------------------------------------------->
                         S {have(she,exists z33.book(z33))}

    >>> printCCGDerivation(parses[4])
       She                 has                           a                book
     NP {she}  ((S\NP)/NP) {\x y.have(y,x)}  (NP/N) {\P.exists z.P(z)}  N {book}
    ---------->T
    (S/(S\NP)) {\F.F(she)}
    ---------------------------------------->B
          (S/NP) {\z37.have(she,z37)}
                                            ------------------------------------->
                                                  NP {exists z17.book(z17)}
    ----------------------------------------------------------------------------->
                         S {have(she,exists z39.book(z39))}

    >>> printCCGDerivation(parses[5])
       She                 has                           a                book
     NP {she}  ((S\NP)/NP) {\x y.have(y,x)}  (NP/N) {\P.exists z.P(z)}  N {book}
    ---------->T
    (S/(S\NP)) {\F.F(she)}
              --------------------------------------------------------->B
                 ((S\NP)/N) {\F25 z22.have(z22,exists z24.F25(z24))}
    ------------------------------------------------------------------->B
                (S/N) {\F43.have(she,exists z41.F43(z41))}
    ----------------------------------------------------------------------------->
                         S {have(she,exists z47.book(z47))}

    >>> printCCGDerivation(parses[6])
       She                 has                           a                book
     NP {she}  ((S\NP)/NP) {\x y.have(y,x)}  (NP/N) {\P.exists z.P(z)}  N {book}
    ---------->T
    (S/(S\NP)) {\F.F(she)}
    ---------------------------------------->B
          (S/NP) {\z37.have(she,z37)}
    ------------------------------------------------------------------->B
                (S/N) {\F46.have(she,exists z45.F46(z45))}
    ----------------------------------------------------------------------------->
                         S {have(she,exists z49.book(z49))}

Complex semantics
-------------------

    >>> lex = lexicon.fromstring('''
    ...     :- S, NP, N
    ...     She => NP {she}
    ...     has => (S\\NP)/NP {\\x y.have(y, x)}
    ...     a => ((S\\NP)\\((S\\NP)/NP))/N {\\P R x.(exists z.(P(z) & R(z,x)))}
    ...     book => N {book}
    ...     ''',
    ...     True)

    >>> parser = chart.CCGChartParser(lex, chart.DefaultRuleSet)
    >>> parses = list(parser.parse("She has a book".split()))
    >>> print(str(len(parses)) + " parses")
    2 parses

    >>> printCCGDerivation(parses[0])
       She                 has                                           a                                 book
     NP {she}  ((S\NP)/NP) {\x y.have(y,x)}  (((S\NP)\((S\NP)/NP))/N) {\P R x.exists z.(P(z) & R(z,x))}  N {book}
                                            ---------------------------------------------------------------------->
                                            ((S\NP)\((S\NP)/NP)) {\F53 z52.exists z51.(book(z51) & F53(z51,z52))}
              ----------------------------------------------------------------------------------------------------<
                                      (S\NP) {\z56.exists z55.(book(z55) & have(z56,z55))}
    --------------------------------------------------------------------------------------------------------------<
                                      S {exists z60.(book(z60) & have(she,z60))}

    >>> printCCGDerivation(parses[1])
       She                 has                                           a                                 book
     NP {she}  ((S\NP)/NP) {\x y.have(y,x)}  (((S\NP)\((S\NP)/NP))/N) {\P R x.exists z.(P(z) & R(z,x))}  N {book}
    ---------->T
    (S/(S\NP)) {\F.F(she)}
                                            ---------------------------------------------------------------------->
                                            ((S\NP)\((S\NP)/NP)) {\F64 z63.exists z62.(book(z62) & F64(z62,z63))}
              ----------------------------------------------------------------------------------------------------<
                                      (S\NP) {\z67.exists z66.(book(z66) & have(z67,z66))}
    -------------------------------------------------------------------------------------------------------------->
                                      S {exists z72.(book(z72) & have(she,z72))}

Using conjunctions
---------------------

    # TODO: The semantics of "and" should have been more flexible
    >>> lex = lexicon.fromstring('''
    ...     :- S, NP, N
    ...     I => NP {I}
    ...     cook => (S\\NP)/NP {\\x y.cook(x,y)}
    ...     and => var\\.,var/.,var {\\P Q x y.(P(x,y) & Q(x,y))}
    ...     eat => (S\\NP)/NP {\\x y.eat(x,y)}
    ...     the => NP/N {\\x.the(x)}
    ...     bacon => N {bacon}
    ...     ''',
    ...     True)

    >>> parser = chart.CCGChartParser(lex, chart.DefaultRuleSet)
    >>> parses = list(parser.parse("I cook and eat the bacon".split()))
    >>> print(str(len(parses)) + " parses")
    7 parses

    >>> printCCGDerivation(parses[0])
       I                 cook                                       and                                        eat                     the            bacon
     NP {I}  ((S\NP)/NP) {\x y.cook(x,y)}  ((_var0\.,_var0)/.,_var0) {\P Q x y.(P(x,y) & Q(x,y))}  ((S\NP)/NP) {\x y.eat(x,y)}  (NP/N) {\x.the(x)}  N {bacon}
                                          ------------------------------------------------------------------------------------->
                                                (((S\NP)/NP)\.,((S\NP)/NP)) {\F76 z75 z74.(eat(z75,z74) & F76(z75,z74))}
            -------------------------------------------------------------------------------------------------------------------<
                                           ((S\NP)/NP) {\z81 z80.(eat(z81,z80) & cook(z81,z80))}
                                                                                                                               ------------------------------->
                                                                                                                                       NP {the(bacon)}
            -------------------------------------------------------------------------------------------------------------------------------------------------->
                                                        (S\NP) {\z86.(eat(the(bacon),z86) & cook(the(bacon),z86))}
    ----------------------------------------------------------------------------------------------------------------------------------------------------------<
                                                           S {(eat(the(bacon),I) & cook(the(bacon),I))}

    >>> printCCGDerivation(parses[1])
       I                 cook                                       and                                        eat                     the            bacon
     NP {I}  ((S\NP)/NP) {\x y.cook(x,y)}  ((_var0\.,_var0)/.,_var0) {\P Q x y.(P(x,y) & Q(x,y))}  ((S\NP)/NP) {\x y.eat(x,y)}  (NP/N) {\x.the(x)}  N {bacon}
                                          ------------------------------------------------------------------------------------->
                                                (((S\NP)/NP)\.,((S\NP)/NP)) {\F76 z75 z74.(eat(z75,z74) & F76(z75,z74))}
            -------------------------------------------------------------------------------------------------------------------<
                                           ((S\NP)/NP) {\z81 z80.(eat(z81,z80) & cook(z81,z80))}
            --------------------------------------------------------------------------------------------------------------------------------------->B
                                                ((S\NP)/N) {\z90 z88.(eat(the(z90),z88) & cook(the(z90),z88))}
            -------------------------------------------------------------------------------------------------------------------------------------------------->
                                                        (S\NP) {\z91.(eat(the(bacon),z91) & cook(the(bacon),z91))}
    ----------------------------------------------------------------------------------------------------------------------------------------------------------<
                                                           S {(eat(the(bacon),I) & cook(the(bacon),I))}

    >>> printCCGDerivation(parses[2])
       I                 cook                                       and                                        eat                     the            bacon
     NP {I}  ((S\NP)/NP) {\x y.cook(x,y)}  ((_var0\.,_var0)/.,_var0) {\P Q x y.(P(x,y) & Q(x,y))}  ((S\NP)/NP) {\x y.eat(x,y)}  (NP/N) {\x.the(x)}  N {bacon}
    -------->T
    (S/(S\NP)) {\F.F(I)}
                                          ------------------------------------------------------------------------------------->
                                                (((S\NP)/NP)\.,((S\NP)/NP)) {\F97 z96 z95.(eat(z96,z95) & F97(z96,z95))}
            -------------------------------------------------------------------------------------------------------------------<
                                        ((S\NP)/NP) {\z102 z101.(eat(z102,z101) & cook(z102,z101))}
                                                                                                                               ------------------------------->
                                                                                                                                       NP {the(bacon)}
            -------------------------------------------------------------------------------------------------------------------------------------------------->
                                                      (S\NP) {\z107.(eat(the(bacon),z107) & cook(the(bacon),z107))}
    ---------------------------------------------------------------------------------------------------------------------------------------------------------->
                                                           S {(eat(the(bacon),I) & cook(the(bacon),I))}

    >>> printCCGDerivation(parses[3])
       I                 cook                                       and                                        eat                     the            bacon
     NP {I}  ((S\NP)/NP) {\x y.cook(x,y)}  ((_var0\.,_var0)/.,_var0) {\P Q x y.(P(x,y) & Q(x,y))}  ((S\NP)/NP) {\x y.eat(x,y)}  (NP/N) {\x.the(x)}  N {bacon}
    -------->T
    (S/(S\NP)) {\F.F(I)}
                                          ------------------------------------------------------------------------------------->
                                                (((S\NP)/NP)\.,((S\NP)/NP)) {\F97 z96 z95.(eat(z96,z95) & F97(z96,z95))}
            -------------------------------------------------------------------------------------------------------------------<
                                        ((S\NP)/NP) {\z102 z101.(eat(z102,z101) & cook(z102,z101))}
            --------------------------------------------------------------------------------------------------------------------------------------->B
                                             ((S\NP)/N) {\z111 z109.(eat(the(z111),z109) & cook(the(z111),z109))}
            -------------------------------------------------------------------------------------------------------------------------------------------------->
                                                      (S\NP) {\z112.(eat(the(bacon),z112) & cook(the(bacon),z112))}
    ---------------------------------------------------------------------------------------------------------------------------------------------------------->
                                                           S {(eat(the(bacon),I) & cook(the(bacon),I))}

    >>> printCCGDerivation(parses[4])
       I                 cook                                       and                                        eat                     the            bacon
     NP {I}  ((S\NP)/NP) {\x y.cook(x,y)}  ((_var0\.,_var0)/.,_var0) {\P Q x y.(P(x,y) & Q(x,y))}  ((S\NP)/NP) {\x y.eat(x,y)}  (NP/N) {\x.the(x)}  N {bacon}
    -------->T
    (S/(S\NP)) {\F.F(I)}
                                          ------------------------------------------------------------------------------------->
                                                (((S\NP)/NP)\.,((S\NP)/NP)) {\F97 z96 z95.(eat(z96,z95) & F97(z96,z95))}
            -------------------------------------------------------------------------------------------------------------------<
